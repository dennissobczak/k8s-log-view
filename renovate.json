{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "repositories": ["dennissobczak/k8s-log-view"],
  "timezone": "UTC",
  "gitAuthor": "dennissobczak <259722231+dennissobczak@users.noreply.github.com>",
  "packageRules": [
    {
      "matchUpdateTypes": ["patch"],
      "automerge": true,
      "automergeType": "pr",
      "automergeSchedule": ["* 17-19 * * *"],
      "platformAutomerge": true
    },
    {
      "matchUpdateTypes": ["minor", "major"],
      "automerge": false
    }
  ]
}
